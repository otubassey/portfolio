{
	"name": "otuekong-portfolio",
	"version": "1.1.2",
	"private": true,
	"description": "A curated monorepo ecosystem of art-driven portfolio themes and server-side vaulting.",
	"author": "Otuekong",
	"license": "MIT",
	"keywords": [
		"design-system",
		"exhibit",
		"gallery",
		"monorepo",
		"nextjs",
		"portfolio",
		"react",
		"typescript"
	],
	"packageManager": "pnpm@11.15.0",
	"scripts": {
		"build": "turbo build",
		"build-hw-classic": "pnpm build --filter=helloworld-classic",
		"build-hw-composite": "pnpm build --filter=helloworld-composite",
		"build-lookbook": "pnpm build --filter=lookbook",
		"build-pavilion": "pnpm build --filter=pavilion",
		"clean": "turbo clean && rm -rf node_modules tsconfig.tsbuildinfo",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"reinstall": "pnpm clean && rm pnpm-lock.yaml && pnpm install",
		"type-check": "turbo type-check"
	},
	"devDependencies": {
		"turbo": "^2.7.2",
		"typescript": "^5"
	},
	"engines": {
		"node": "24.x",
		"pnpm": ">=11.0.0"
	}
}
