{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "preserve",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"rootDirs": [
			"./packages/archives/src",
			"./packages/common/src",
			"./packages/curio/src",
			"./packages/exhibit/src",
			"./packages/features/src",
			"./packages/infrastructure-server/src"
		],
		"paths": {
			// Package Paths
			"@otuekong-portfolio/archives": ["./packages/archives/src"],
			"@otuekong-portfolio/archives/*": ["./packages/archives/src/*"],
			"@otuekong-portfolio/curio": ["./packages/curio/src"],
			"@otuekong-portfolio/curio/*": ["./packages/curio/src/*"],
			"@otuekong-portfolio/common": ["./packages/common/src"],
			"@otuekong-portfolio/common/*": ["./packages/common/src/*"],
			"@otuekong-portfolio/exhibit": ["./packages/exhibit/src"],
			"@otuekong-portfolio/exhibit/*": ["./packages/exhibit/src/*"],
			"@otuekong-portfolio/features": ["./packages/features/src"],
			"@otuekong-portfolio/features/*": ["./packages/features/src/*"],
			"@otuekong-portfolio/infrastructure-server": ["./packages/infrastructure-server/src"],
			"@otuekong-portfolio/infrastructure-server/*": ["./packages/infrastructure-server/src/*"],

			// Lookbook paths
			"lookbook": ["./apps/lookbook/"],
			"lookbook/*": ["./apps/lookbook/*"],

			// Pavilion Paths
			"pavilion": ["./apps/pavilion/"],
			"pavilion/*": ["./apps/pavilion/*"],

			// Gallery App Paths
			"helloworld-classic": ["./apps/galleries/helloworld/classic/"],
			"helloworld-classic/*": ["./apps/galleries/helloworld/classic/*"],
			"helloworld-composite": ["./apps/galleries/helloworld/composite/"],
			"helloworld-composite/*": ["./apps/galleries/helloworld/composite/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020"
	}
}
