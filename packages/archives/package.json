{
	"name": "@otuekong-portfolio/archives",
	"version": "1.0.1-rc-1",
	"description": "Domain-driven UI and business logic. Exports professional entities and their associated business logic and hooks.",
	"author": "Otuekong",
	"type": "module",
	"main": "./dist/clientIndex.js",
	"types": "./dist/clientIndex.d.ts",
	"license": "MIT",
	"keywords": [
		"Business-Rules",
		"domains",
		"Domain-Logic",
		"Entities",
		"professional",
		"profile",
		"projects"
	],
	"packageManager": "pnpm@11.15.0",
	"exports": {
		"./contact-server": {
			"default": "./dist/contact/server/index.js",
			"types": "./dist/contact/server/index.d.ts"
		},
		"./contact-ui": {
			"default": "./dist/contact/ui/index.js",
			"types": "./dist/contact/ui/index.d.ts"
		},
		"./professional": {
			"default": "./dist/professional/index.js",
			"types": "./dist/professional/index.d.ts"
		},
		"./profile": {
			"default": "./dist/profile/index.js",
			"types": "./dist/profile/index.d.ts"
		},
		"./server": {
			"default": "./dist/serverIndex.js",
			"types": "./dist/serverIndex.d.ts"
		},
		"./showroom": {
			"default": "./dist/showroom/index.js",
			"types": "./dist/showroom/index.d.ts"
		},
		"./ui": {
			"default": "./dist/clientIndex.js",
			"types": "./dist/clientIndex.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist node_modules tsconfig.tsbuildinfo .turbo",
		"build": "tsc -b tsconfig.json",
		"lint": "eslint \"**/*.ts*\"",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@otuekong-portfolio/common": "workspace:*",
		"@otuekong-portfolio/curio": "workspace:*",
		"@otuekong-portfolio/infrastructure-server": "workspace:*",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"typescript": "^5"
	}
}
