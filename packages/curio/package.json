{
	"name": "@otuekong-portfolio/curio",
	"version": "1.0.1",
	"description": "The unified UI foundation for the Otuekong's Portfolio ecosystem. Combines atomic presentational components, design tokens, shared React hooks, and common TypeScript utilities, and developer tooling.",
	"author": "Otuekong",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "MIT",
	"keywords": [
		"atoms",
		"components",
		"design-system",
		"foundation",
		"hooks",
		"react",
		"tailwind",
		"tokens",
		"typescript",
		"ui",
		"utilities"
	],
	"packageManager": "pnpm@11.15.0",
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./base": "./src/base.css",
		"./components": {
			"default": "./dist/components/index.js",
			"types": "./dist/components/index.d.ts"
		},
		"./hooks": {
			"default": "./dist/hooks/externalIndex.js",
			"types": "./dist/hooks/externalIndex.d.ts"
		},
		"./playground": {
			"default": "./dist/playground/index.js",
			"types": "./dist/playground/index.d.ts"
		},
		"./theme": {
			"default": "./dist/theme/index.js",
			"types": "./dist/theme/index.d.ts"
		},
		"./utils": {
			"default": "./dist/utils/index.js",
			"types": "./dist/utils/index.d.ts"
		}
	},
	"files": [
		"dist",
		"src/base.css"
	],
	"scripts": {
		"clean": "rm -rf dist node_modules tsconfig.tsbuildinfo .turbo",
		"build": "tsc -b tsconfig.json",
		"lint": "eslint \"**/*.ts*\"",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@otuekong-portfolio/common": "workspace:*",
		"clsx": "^2.1.1",
		"lucide-react": "^0.562.0",
		"react-icons": "^5.5.0",
		"react-shadow": "^20.6.0",
		"tailwind-merge": "^3.4.0"
	},
	"peerDependencies": {
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"tailwindcss": "^4"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5",
		"eslint": "^9"
	}
}
