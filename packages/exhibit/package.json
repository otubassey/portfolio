{
	"name": "@otuekong-portfolio/exhibit",
	"version": "1.0.1-rc-2",
	"description": "The structural framework for assembling page experiences. This package consumes the design system and core logic to provide high-level structural components, such as application shells, navigation rails, and responsive grids. It acts as the bridge between raw domain data and the final user interface, defining how different versions of the portfolio are composed.",
	"author": "Otuekong",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "MIT",
	"keywords": [
		"composition",
		"exhibit",
		"layouts",
		"pages",
		"portfolio",
		"Unified"
	],
	"packageManager": "pnpm@11.15.0",
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./common-client": {
			"default": "./dist/common/client/index.js",
			"types": "./dist/common/client/index.d.ts"
		},
		"./common-server": {
			"default": "./dist/common/server/index.js",
			"types": "./dist/common/server/index.d.ts"
		},
		"./galleries": {
			"default": "./dist/galleries/index.js",
			"types": "./dist/galleries/index.d.ts"
		},
		"./helloworld-classic-client": {
			"default": "./dist/galleries/helloworld/classic/ui/index.js",
			"types": "./dist/galleries/helloworld/classic/ui/index.d.ts"
		},
		"./helloworld-classic-server": {
			"default": "./dist/galleries/helloworld/classic/server/index.js",
			"types": "./dist/galleries/helloworld/classic/server/index.d.ts"
		},
		"./helloworld-composite-client": {
			"default": "./dist/galleries/helloworld/composite/ui/index.js",
			"types": "./dist/galleries/helloworld/composite/ui/index.d.ts"
		},
		"./helloworld-composite-server": {
			"default": "./dist/galleries/helloworld/composite/server/index.js",
			"types": "./dist/galleries/helloworld/composite/server/index.d.ts"
		},
		"./lookbook": {
			"default": "./dist/lookbook/index.js",
			"types": "./dist/lookbook/index.d.ts"
		},
		"./pavilion": {
			"default": "./dist/pavilion/ui/index.js",
			"types": "./dist/pavilion/ui/index.d.ts"
		},
		"./pavilion-server": {
			"default": "./dist/pavilion/server/index.js",
			"types": "./dist/pavilion/server/index.d.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist node_modules tsconfig.tsbuildinfo .turbo",
		"build": "tsc -b tsconfig.json",
		"lint": "eslint \"**/*.ts*\"",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@otuekong-portfolio/common": "workspace:*",
		"@otuekong-portfolio/curio": "workspace:*",
		"@otuekong-portfolio/features": "workspace:*",
		"@otuekong-portfolio/infrastructure-server": "workspace:*",
		"@vercel/functions": "^1.6.0",
    	"next": "16.1.1"
	},
	"peerDependencies": {
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"typescript": "^5"
	}
}
