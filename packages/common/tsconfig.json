{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"composite": true,
		"declaration": true,
		"declarationDir": "dist",
		"declarationMap": true,
		"jsx": "react-jsx",
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
