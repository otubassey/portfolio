{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"CLIENT_LOG_LEVEL",
		"CRON_SECRET",
		"ENABLE_EXPERIMENTAL_COREPACK",
		"LOG_LEVEL",
		"PORTFOLIO_EMAIL_SENDER",
		"PORTFOLIO_EMAIL_TARGET",
		"RESEND_API_KEY",
		"SERVER_LOG_LEVEL",
		"UPSTASH_REDIS_REST_TOKEN",
		"UPSTASH_REDIS_REST_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"standalone/**",
        		"static/**",
				"dist/**"
			],
			"env": ["NODE_ENV"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"type-check": {
			"dependsOn": ["^type-check"],
			"outputs": ["dist/**"]
		},
		"clean": {
			"cache": false,
			"dependsOn": ["^clean"]
		}
	}
}
